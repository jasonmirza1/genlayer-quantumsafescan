# GenLayer RPC API URL
# Bradbury testnet RPC
NEXT_PUBLIC_GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com

# GenLayer Network Configuration
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Bradbury
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# QuantumSafeScan Lite Contract Address
# Set this after deploying QuantumSafeScan to Bradbury.
NEXT_PUBLIC_CONTRACT_ADDRESS=0xYOUR_BRADBURY_CONTRACT_ADDRESS

# Keep v1 as the default. Opt in only after deploying the separate v2 contract.
NEXT_PUBLIC_SCAN_VERSION=1
# For v2: NEXT_PUBLIC_SCAN_VERSION=2
# V2 uses the fixed Studio Next RPC/chain 61997, not the old Bradbury address.
# NEXT_PUBLIC_V2_CONTRACT_ADDRESS=0xYOUR_NEW_STUDIO_NEXT_V2_ADDRESS
